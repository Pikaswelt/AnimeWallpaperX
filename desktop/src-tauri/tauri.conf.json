{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnimeWallpaperX",
  "version": "1.0.0",
  "identifier": "com.pikaswelt.animewallpaperx",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AnimeWallpaperX",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "resources": ["wallpapers/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
